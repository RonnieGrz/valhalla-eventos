rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cubre cualquier subcolección "payments" sin importar su profundidad/ruta exacta,
    // para que las consultas collectionGroup(db, "payments") del dashboard nunca sean
    // rechazadas por no estar cubiertas por las reglas anidadas específicas de abajo
    // (p. ej. pagos de un esquema anterior con una jerarquía distinta).
    match /{path=**}/payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read, write: if request.auth != null;

      match /localities/{localityId} {
        allow read, write: if request.auth != null;

        match /palcos/{palcoId} {
          allow read, write: if request.auth != null;

          match /payments/{paymentId} {
            allow read, write: if request.auth != null;
          }

          match /boletaSales/{saleId} {
            allow read, write: if request.auth != null;

            match /payments/{paymentId} {
              allow read, write: if request.auth != null;
            }
          }
        }

        match /boletaSales/{saleId} {
          allow read, write: if request.auth != null;

          match /payments/{paymentId} {
            allow read, write: if request.auth != null;
          }
        }
      }
    }
  }
}
